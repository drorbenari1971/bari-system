    "claim": "UPDATE ... RETURNING על המשימה המוכנה עם העדיפות הגבוהה ביותר, ואז הוותיקה ביותר",
    "worker": {
      "concurrency": 2,
      "tickMs": 2000
    },
    "retry": {
      "maxAttempts": 8,
      "backoffMs": [
        10000,
        30000,
        120000,
        600000,
        1800000,
        3600000
      ],
      "honorsProviderRetryAfter": true,
      "permanentErrors": "נכשלות מיד (למשל הרשאה, משימה בלי מטפל)"
    },
    "dedupe": "dedupe_key ייחודי רק בזמן שהמשימה pending/processing/retry",
    "staleLock": "משימה שתקועה ב-processing יותר מ-5 דקות חוזרת ל-retry (וכולן בעליית השרת)",
    "cleanup": "משימות completed נמחקות אחרי 30 יום; failed נשמרות עד טיפול"
