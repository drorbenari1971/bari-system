{
  "$comment": "Blueprint of the Morning -> customers module automation, generated from the code in backend/accounting. Contains no secrets, tunnel addresses, tokens or customer data.",
  "blueprint": {
    "name": "בריא - ניהול לקוחות: סנכרון Morning",
    "version": "1.1",
    "generatedAt": "2026-11-19",
    "sourceCommit": "115f5cb",
    "branch": "main",
    "design": "docs/customers-module-design.md",
    "summary": "סנכרון לקוחות ומסמכים (קבלות/חשבוניות) מ-Morning למערכת המקומית. ה-API Pull הוא מקור האמת, ו-Webhook הוא רק טריגר מזרז. כל העבודה עוברת דרך תור משימות פנימי, עם ניסיונות חוזרים, מניעת כפילויות ו-Audit Log. בנוסף: טופס \"הזמנה חדשה\" שקולט לקוח ומפיק קבלה ב-Morning, עם הגנה מקבלה כפולה."
  },
  "runtime": {
    "process": "שרת Node אחד (backend/server.js), שמפעיל את המודול דרך startAccounting()",
    "nodeVersion": ">=22.13 (node:sqlite)",
    "database": "SQLite: backend/data/bari.db (לא נכנס ל-git)",
    "appListener": {
      "host": "127.0.0.1",
      "port": 4000,
      "exposure": "מקומי בלבד: בקשה עם Host/Origin שאינו localhost נדחית ב-403"
    },
    "webhookListener": {
      "host": "127.0.0.1",
      "port": "WEBHOOK_PORT (ברירת מחדל 4100)",
      "exposure": "רק דרך המנהרה",
      "file": "backend/accounting/webhookReceiver.js"
    },
    "tunnel": {
      "tool": "ngrok",
      "endpointName": "bari-webhooks",
      "upstream": "http://127.0.0.1:4100",
      "configLocation": "%LOCALAPPDATA%\\ngrok\\ngrok.yml (מקומי; הכתובת והטוקן לא בפרויקט)",
      "startedBy": "start.bat, אם ngrok מותקן ועדיין לא רץ"
    },
    "startup": [
      "startWorker(): שחרור משימות שנתקעו בעיבוד, ואז מחזור כל 2 שניות",
      "startPolling(): בדיקת תזמון כל 60 שניות",
      "startWebhookReceiver(): מאזין Webhooks וניקוי ארכיון כל שעה",
      "בדיקת בריאות Webhook והתראה בלוג כל 60 שניות"
    ]
  },
  "provider": {
    "id": "morning",
    "label": "Morning (חשבונית ירוקה)",
    "spec": "https://developers.morning.co/docs/openapi.bundled.json (v2.0.0)",
    "environments": {
      "production": {
        "auth": "https://api.morning.co",
        "api": "https://api.greeninvoice.co.il/api/v1"
      },
      "sandbox": {
        "auth": "https://api.sandbox.morning.dev",
        "api": "https://sandbox.d.greeninvoice.co.il/api/v1"
      }
    },
    "capabilities": {
      "issuesReceipts": true,
      "webhooks": true,
      "lineItems": true,
      "pdfLinks": true,
      "updatedSinceFilter": false,
      "documentUpdateEvents": false
    },
    "auth": {
      "flow": "OAuth client_credentials",
      "request": "POST {auth}/idp/v1/oauth/token { grant_type, client_id, client_secret }",
      "tokenLifetime": "שעה (expiresAt)",
      "cache": "לפי סביבה ו-clientId; חידוש דקה לפני התפוגה",
      "credentialsStorage": "acc_connections.credentials_enc, מוצפן AES-256-GCM במפתח ACCOUNTING_SECRET_KEY"
    },
    "calls": [
      {
        "name": "listCustomers",
        "request": "POST /clients/search { page, pageSize: 100 }",
        "use": "סנכרון לקוחות"
      },
      {
        "name": "getCustomer",
        "request": "GET /clients/{id}",
        "use": "fetch_customer (Webhook)",
        "notFound": "null"
      },
      {
        "name": "listDocuments",
        "request": "POST /documents/search { page, pageSize: 100, sort: 'documentDate' }",
        "use": "סנכרון מסמכים (כולל שורות ותשלומים)"
      },
      {
        "name": "getDocument",
        "request": "GET /documents/{id}",
        "use": "fetch_document (כולל linkedDocuments)",
        "notFound": "null"
      },
      {
        "name": "testConnection",
        "request": "טוקן חדש + POST /documents/search { page: 1, pageSize: 1 }",
        "use": "בדיקת חיבור"
      },
      {
        "name": "listItems",
        "request": "POST /items/search",
        "use": "קטלוג המוצרים לטופס (cache של 5 דקות)"
      },
      {
        "name": "createCustomer",
        "request": "POST /clients (send: false, בלי פרטי בנק)",
        "use": "כרטיס לקוח ללקוח חדש",
        "creates": true
      },
      {
        "name": "previewReceipt",
        "request": "POST /documents/preview",
        "use": "תצוגה מקדימה (PDF ב-base64) בלי ליצור כלום"
      },
      {
        "name": "createReceipt",
        "request": "POST /documents { type: 400, vatType: 0, lang: he }",
        "use": "הפקת הקבלה",
        "creates": true
      },
      {
        "name": "findReceipts",
        "request": "POST /documents/search { type: [400], clientId, fromDate, toDate }",
        "use": "בדיקת הזמנה לא ודאית"
      }
    ],
    "httpPolicy": {
      "timeoutMs": 30000,
      "retryInsideRequestMs": [
        1000,
        3000,
        9000
      ],
      "retryOn": [
        "429",
        "5xx",
        "שגיאת רשת"
      ],
      "honorsRetryAfter": true,
      "on401": "חידוש טוקן פעם אחת וחזרה על הבקשה",
      "errorCodes": {
        "401": "auth_failed",
        "403": "forbidden",
        "404": "not_found",
        "429": "rate_limited",
        "5xx": "server_error",
        "4xx": "request_error",
        "network": "network"
      },
      "createCalls": "קריאה שיוצרת (creates: true) לא חוזרת על עצמה אחרי תקלת רשת, timeout או 5xx, ומסומנת err.uncertain; חוזרת רק אחרי 401 או 429, שמוכיחים שלא נוצר כלום"
    }
  },
  "triggers": [
    {
      "id": "initial_sync",
      "type": "schedule",
      "when": "החיבור במצב ok ועדיין אין ריצת סנכרון",
      "enqueues": "customers_sync",
      "source": "system"
    },
    {
      "id": "periodic_sync",
      "type": "schedule",
      "checkEverySeconds": 60,
      "intervalMinutes": {
        "options": [
          15,
          60,
          360
        ],
        "default": 60,
        "setting": "acc_connections.settings.customerSyncMinutes"
      },
      "conditions": [
        "flags.polling",
        "flags.autoSync",
        "החיבור מופעל ובמצב ok",
        "אין ריצה פעילה"
      ],
      "enqueues": "customers_sync",
      "source": "polling"
    },
    {
      "id": "manual_sync",
      "type": "button",
      "where": "ניהול לקוחות ← סנכרון והגדרות ← סנכרן עכשיו",
      "api": "POST /api/accounting/connections/:id/sync",
      "conditions": [
        "החיבור מופעל (המתגים לא חוסמים סנכרון ידני)"
      ],
      "enqueues": "customers_sync",
      "source": "manual"
    },
    {
      "id": "morning_webhook",
      "type": "webhook",
      "route": "POST /<provider>/<url-token> במאזין הנפרד",
      "activeTopics": [
        "client/created"
      ],
      "recognisedButInactive": [
        "document/created"
      ],
      "enqueues": "fetch_customer { externalId }",
      "dedupeKey": "fetch_customer:<connection>:<externalId>",
      "source": "webhook",
      "conditions": [
        "flags.webhooks (WEBHOOKS_ENABLED, ברירת מחדל: כבוי)",
        "חתימה תקינה",
        "החיבור מופעל"
      ]
    },
    {
      "id": "replay",
      "type": "button",
      "where": "כרטיס ה-Webhook ← שליחות אחרונות ← הרץ שוב",
      "api": "POST /api/accounting/webhook-deliveries/:id/replay",
      "enqueues": "אותה משימה כמו בשליחה המקורית",
      "source": "replay"
    },
    {
      "id": "retry_job",
      "type": "button",
      "where": "כרטיס הניטור ← נסה שוב עכשיו",
      "api": "POST /api/accounting/jobs/:id/retry",
      "effect": "משימה שנכשלה או ממתינה חוזרת ל-pending עם ניסיונות מאופסים"
    },
    {
      "id": "new_order",
      "type": "button",
      "where": "ניהול לקוחות ← לקוחות ← \"הזמנה חדשה\", או כרטיס לקוח ← \"הזמנה חדשה ללקוח\"",
      "api": "POST /api/accounting/orders { connectionId, orderKey, order }",
      "effect": "כרטיס לקוח (אם צריך) וקבלה ב-Morning, ושמירה מקומית מיד",
      "source": "manual"
    }
  ],
  "flow": {
    "description": "שרשרת משימות בתור: לקוחות קודם, ואחריהם מסמכים, כדי שקבלות יתחברו לכרטיסי לקוח קיימים.",
    "steps": [
      {
        "job": "customers_sync",
        "does": "פותח ריצה (acc_sync_runs.type = customers) ומכניס את דף 1",
        "next": "customers_page"
      },
      {
        "job": "customers_page",
        "does": "קורא דף של 100 לקוחות, שומר רק שינויים (content_hash), ומכניס את הדף הבא",
        "next": "customers_page | customers_finalize"
      },
      {
        "job": "customers_finalize",
        "does": "מסמן לקוחות שלא הוחזרו (הוסר במקור אחרי 2 ריצות מלאות ברצף), סוגר את הריצה",
        "next": "documents_sync"
      },
      {
        "job": "documents_sync",
        "does": "פותח ריצה (type = documents) ומכניס את דף 1",
        "next": "documents_page"
      },
      {
        "job": "documents_page",
        "does": "קורא דף של 100 מסמכים עם שורות ותשלומים, מזהה את הלקוח, שומר רק שינויים",
        "next": "documents_page | documents_finalize"
      },
      {
        "job": "documents_finalize",
        "does": "סוגר את הריצה (מסמכים לא מסומנים כהוסרו)",
        "next": null
      }
    ],
    "singleRecordJobs": [
      {
        "job": "fetch_customer",
        "does": "GET /clients/{id} ושמירה; notFound אם Morning לא מכירה את הלקוח"
      },
      {
        "job": "fetch_document",
        "does": "GET /documents/{id} ושמירה; מוכן ל-document/created"
      }
    ],
    "guards": {
      "oneRunAtATime": "ריצה פעילה עם משימות חיות חוסמת ריצה חדשה לאותו חיבור וסוג",
      "supersededRun": "דף או סיום של ריצה ישנה מדולגים כשהתחילה ריצה חדשה יותר",
      "pageAlreadyDone": "חזרה על דף שכבר עובד (קריסה בין שמירה לסיום) מדולגת",
      "disabledConnection": "ריצה של חיבור מושבת או מחוק מבוטלת",
      "badRecord": "רשומה פגומה לא עוצרת את הדף; נספרת ב-failed ונשמרת ב-item_errors (עד 20)",
      "removalSafety": "סימון הסרה מדולג אם חלק מהלקוחות לא נשמרו, או אם Morning החזירה פחות מ-50% מהלקוחות המוכרים",
      "authFailure": "שגיאת הרשאה סופית מסמנת את החיבור כ-error, והתזמון נעצר עד בדיקת חיבור מוצלחת"
    }
  },
  "queue": {
    "table": "acc_jobs",
    "statuses": [
      "pending",
      "processing",
      "completed",
      "failed",
      "retry"
    ],
    "priority": {
      "webhook": 10,
      "manual": 5,
      "replay": 5,
      "polling": 0,
      "system": 0
