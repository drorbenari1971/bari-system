# ------------------------------------------------------------
#  Bari (בריא) - environment configuration
#  Copy to .env (setup.bat does this for you) and fill in keys.
#  Any integration left empty runs in DEMO / simulation mode.
# ------------------------------------------------------------

# Server
PORT=4000
# Seed demo posts/metrics/comments on first run (true/false)
SEED_DEMO=true

# --- Anthropic Claude (post copy, insights, reply suggestions) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Image generation (OpenAI Images API) ---
# gpt-image-1 (recommended) or dall-e-3
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1

# --- Meta Graph API (Facebook Page + Instagram Business) ---
META_GRAPH_VERSION=v21.0
META_PAGE_ID=
# Long-lived PAGE access token (not a user token)
META_PAGE_ACCESS_TOKEN=
# Instagram Business Account ID connected to the page
META_IG_USER_ID=
# App secret - used to verify webhook signatures (X-Hub-Signature-256)
META_APP_SECRET=
# Any string you choose; enter the same value in the Meta app webhook settings
META_WEBHOOK_VERIFY_TOKEN=bari-verify-token

# --- Cloudinary (image hosting, required for Instagram) ---
# Instagram downloads images from a public URL, so they are uploaded here when
# publishing. Values are on the Cloudinary dashboard (API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
